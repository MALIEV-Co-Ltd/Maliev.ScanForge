    "scope": "Static decoding plus identity-bound repeated passive code, descriptors, vtable and selected exception-entry reads. No target calls, writes, geometry-buffer reads, UI input or preserved-image execution."
  },
  "contracts": {
    "selectionState": "The line tool embeds the shared selector and enables sketch selection. Cached owner, child, child index and record index are separate. The updater locates the supplied child by pointer in the owner list.",
    "storedRecordNamespace": "Selection values >=200000 use scene iterator order and its +0x230 object predicate, then sketch owner, child and stored +0x170 record order. Match assigns child pointer, child index and record index. Owner return is gated by the selector sketch flag. Lower values use separate child/object paths.",
    "lineHoverAdmission": "Reject sketch selection with record index -1 and exclude the line being constructed.",
    "selectionDrawing": "The selected drawing caller initializes child/record counters at 10000/200000, disables alternate/control-record flags and uses +0x170 records. Recursive child drawing exists; nested-group index correspondence remains unresolved.",
    "highlightPrecision": "Selected-record highlight transforms original Float64 local coordinates before final Float32 display conversion. Do not reuse click acquisition, which also rounds local coordinates first.",
    "genericHitTesting": "Separate provider and scan branches remain to be fully bound and validated numerically; full-code matching alone does not establish their complete behavior."
  },
  "implemented": [
    "resolveSketchConstructionPick binds source ID, child ID and record index against an already resolved ordered snapshot.",
    "Returns detached selection description, retained Float32 object pick and evaluated primitive from the existing ordered nearest-record resolver.",
    "Rejects source mismatch, missing/duplicate child identities, invalid record indices and nonfinite canonical source data.",
    "Stable arbitrary application string IDs are adapter policy, not native viewport numbers. No missing legacy records are fabricated."
  ],
