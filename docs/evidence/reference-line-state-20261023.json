  "rules": [
    {
      "id": "initial-inner-state",
      "entries": ["0x14040c5c0", "0x14040cd60"],
      "finding": "Inner start, direction and length initialize to zero; outer mode initializes to 2. These constructor values are distinct from command-level defaults."
    },
    {
      "id": "command-default",
      "entry": "0x140805700",
      "finding": "Before later dialog/preselection adjustments, finite valid scene bounds seed endpoints (minX,0,0) and (maxX,0,0); invalid/inverted or extreme sentinel bounds select (0,0,0) to (10,0,0). A zero X span does not automatically select the 10 mm fallback."
    },
    {
      "id": "endpoint-setter",
      "entry": "0x140a93410",
      "finding": "Compute sqrt((dy squared + dx squared) + dz squared), require length strictly greater than 2^-52, then store start, normalized direction and length. Rejection writes none of those fields."
    },
    {
      "id": "typed-controller",
      "entry": "0x140573170",
      "finding": "Mode 2 converts six displayed endpoint coordinates to internal units and uses sqrt((dx squared + dy squared) + dz squared). It updates geometry only for length > 2^-52. This arithmetic order differs from the general endpoint setter."
    },
    {
      "id": "length-display",
      "entries": ["0x1405712b0", "0x1405726f0", "0x140573170"],
      "finding": "Length member +0x36e8 is registered to control 0x421. Display refresh reconstructs the second endpoint from stored start/direction/length and measures endpoint distance before unit conversion; it does not simply display stored length. Editable-length behavior is not established."
    },
    {
      "id": "line-record-order",
      "entries": ["0x14040e340", "0x140573170"],
      "finding": "Mode 3 consumes the first two ordered 28-byte retained records. The controller appends first selector and second selector records independently of the common deduplicated input set. Mode 5 iterates that record vector, with a nonempty common-input-set guard."
    },
    {
      "id": "line-duplicates",
      "entry": "0x140573170",
      "finding": "The inspected controller does not deduplicate retained records. Two records can carry one identity while the dependency set has one member. Native UI admission of such selections remains unverified."
    },
    {
      "id": "missing-input-finalization",
      "entry": "0x14040e340",
      "finding": "Candidate endpoints start from the old stored line. Missing inputs can lead to endpoint reconstruction and renormalization, so old geometry is not necessarily preserved bit-for-bit."
    },
    {
      "id": "degenerate-finalization",
      "entry": "0x14040e340",
      "finding": "Mode 3 and mode 5 final length <= 2^-52 skips geometry stores but reaches the ordinary two-byte 0x100 store at outer+0x2b0. Initial guard failure skips both geometry and that store."
    },
    {
      "id": "average-order",
      "entry": "0x14040e340",
      "finding": "Each successfully extracted axis increments contribution count, adds its unweighted midpoint, updates maximum half-length and contributes a normalized/sign-adjusted direction in record order. A zero-length extracted axis must not be silently filtered after successful extraction."
    },
    {
      "id": "average-extent",
      "entry": "0x14040e340",
      "finding": "For prior length <= 2^-23, use average midpoint plus/minus maximum input half-length. For larger prior length, project previous endpoints onto the average line. Finalization still applies the strict 2^-52 length test."
    }
  ],
