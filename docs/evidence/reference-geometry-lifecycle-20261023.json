    {
      "id": "source-and-dependent-links",
      "evidenceType": "static call and memory data flow, linked to prior generic refresh evidence",
      "summary": "Acceptance removes old reverse links and clears the source-reference set before adding mode-specific source identifiers. Separate ordered sets retain inputs and dependents. Shared methods insert, erase and clear each set.",
      "entries": [
        "0x140573930",
        "0x14057fcd0",
        "0x140406f60",
        "0x140406f90",
        "0x140406fc0",
        "0x140407000"
      ]
    },
    {
      "id": "persistent-identity-and-links",
      "evidenceType": "static paired write/read branches",
      "summary": "The common reference record stores the 16-byte object identity, update level, counted source identifiers and counted dependent identifiers. Load clears each destination set and inserts its saved identifiers. Names are serialized separately as counted UTF-16 code units.",
      "entries": ["0x140471f30", "0x14046f820"]
    },
    {
      "id": "persistent-line-definition",
      "evidenceType": "static paired write/read branches",
      "summary": "The reference-line record retains double-precision start/end coordinates, the four-byte construction mode, counted 28-byte entries split into 16-byte identity and 12-byte coordinate portions, and a separate counted array of 12-byte coordinate records. These arrays are distinct from the common input/dependent sets.",
      "entries": ["0x140489120"]
    },
    {
      "id": "persistent-point-definition",
      "evidenceType": "static paired write/read branches",
      "summary": "The reference-point record retains its three double-precision coordinates, three four-byte fields at object offsets 0x2b8/0x2bc/0x2c0, a 12-byte field at 0x2c4, and a counted array of 12-byte coordinate records. The first field is the construction mode; meanings and mode coverage of the others still require control-path correlation.",
      "entries": ["0x140489840"]
    },
    {
      "id": "distinct-geometry-payload",
      "evidenceType": "static paired write/read branches",
      "summary": "Object-level geometry payload methods are separate from the full reference records. Their line load reconstructs a normalized direction and length; they do not by themselves prove preservation of the construction recipe.",
      "entries": ["0x14040d340", "0x14040d460", "0x14041ac20", "0x14041ad20"]
    }
  ],
