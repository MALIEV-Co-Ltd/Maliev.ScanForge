  "contracts": {
    "centerRadiusInput": [
      "For already validated finite inputs, radius at or above 2^-23 admits three ordered points.",
      "Positive local X times radius plus center, positive local Y times radius plus center, then center minus local X times radius.",
      "Input helper preserves Z; the circle child subsequently projects to local Z zero and refits its center.",
      "The input threshold is not a final-fit success guarantee. The command helper does not establish all interactive creation paths."
    ],
    "radiusEdit": [
      "Negative input is negated; magnitudes strictly below 2^-23 become 0.01.",
      "The first/middle/last defining points retain their radial directions rather than resetting to cardinal points.",
      "Degenerate middle radial direction falls back to the observed local +Y vector."
    ],
    "pointEdit": [
      "Indices zero through two replace the selected defining point and call the three-point builder.",
      "Index three translates defining points and center in local XY, refreshes source records, and calls the circle backend."
    ],
    "transform": "Selected circle transform method applies the supplied 3x4 affine transform to the three defining points, then invokes the three-point builder with the stored child frame. Full owner/pick provenance remains unproven."
  },
  "implemented": [
    "nativeReferenceCircleInputPoints returns detached ordered point records or undefined for subthreshold finite radii.",
    "Explicit zero products and additions/subtractions retain signed-zero semantics.",
    "It is an internal dependency and does not change GUI or MCP sketch behavior."
  ],
